# Copia este archivo como .env (nunca se sube al repositorio).

# Cadena de conexion a MongoDB (Atlas M0 gratis, o una instancia local)
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/gestor_casos_qa

# Secreto que firma las sesiones (cookie). Genera el tuyo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia_esto_por_un_valor_generado

# Duracion de la sesion, en horas
SESION_HORAS=8

# Puerto del servidor web (opcional, por defecto 8000)
PORT=8000

# Recuperación de cuenta por correo (API de Brevo). Sin clave, el enlace solo
# se escribe en el log. En producción vienen de los secretos de GitHub.
BREVO_API_KEY=
BREVO_REMITENTE=
URL_PUBLICA=http://127.0.0.1:8000
